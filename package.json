{
  "name": "7-kilitos-store",
  "version": "1.0.0",
  "private": true,
  "description": "Tienda online y panel administrativo de 7 Kilitos Store (HTML, CSS, JavaScript y Firebase).",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix functions install",
    "dev": "firebase emulators:start --project demo-7kilitos",
    "seed:emulator": "node functions/scripts/seed.js --emulator",
    "admin:emulator": "node functions/scripts/set-role.js --emulator",
    "test": "npm run test:unit && npm run test:emulated && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:emulated": "firebase emulators:exec --project demo-7kilitos --only auth,firestore,storage \"node --test --test-concurrency=1 tests/rules/*.test.js tests/functions/*.test.js\"",
    "test:e2e": "firebase emulators:exec --project demo-7kilitos --only auth,firestore,storage,functions,hosting \"playwright test\"",
    "check:icons": "node scripts/sync-icons.mjs --check",
    "icons": "node scripts/sync-icons.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.56.1",
    "eslint": "10.1.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.33.0"
  }
}
