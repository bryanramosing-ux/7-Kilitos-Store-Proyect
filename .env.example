# Variables para los SCRIPTS DE ADMINISTRACIÓN que se ejecutan en tu computador
# (functions/scripts/seed.js y functions/scripts/set-role.js) contra el proyecto real.
# Copia este archivo como .env solo si te resulta cómodo; .env está en .gitignore.
#
# La app web NO usa variables de entorno ni secretos: su configuración pública
# está en public/js/firebase/config.js. Nunca pongas claves privadas en public/.

# Opción A (recomendada): credenciales de tu cuenta de Google, sin archivos de clave:
#   gcloud auth application-default login
#
# Opción B: archivo de clave de una cuenta de servicio, guardado FUERA del repositorio:
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/fuera-del-repo/clave-cuenta-servicio.json

# ID del proyecto Firebase (el mismo de .firebaserc)
FIREBASE_PROJECT_ID=PENDIENTE-ID-DEL-PROYECTO
